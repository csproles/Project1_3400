# Ignore Python cache files and folders
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments
venv/
.env/
.venv/
env/

# Ignore compiled packages and logs
*.so
*.log

# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE settings
.vscode/
.idea/

# Ignore output and temporary files
output/
*.tmp
*.pickle
*.pkl

# Ignore Excel/CSV test data if you don’t want to commit them
Input/*.csv
Input/*.pkl
